# =============================================================================
# WebSec Audit Dashboard - Environment Configuration Template
# Copy this file to .env and replace placeholder credentials before deployment.
# NEVER commit .env to version control.
# =============================================================================

# --- Environment ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=websec
POSTGRES_PASSWORD=CHANGE_ME_STRONG_LOCAL_PASSWORD
POSTGRES_DB=websec_audit
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async driver for FastAPI (asyncpg) and Sync driver for Celery/Alembic (psycopg)
DATABASE_URL=postgresql+asyncpg://websec:CHANGE_ME_STRONG_LOCAL_PASSWORD@postgres:5432/websec_audit
SYNC_DATABASE_URL=postgresql+psycopg://websec:CHANGE_ME_STRONG_LOCAL_PASSWORD@postgres:5432/websec_audit

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Backend Security & Governance ---
# Strict domain verification is enforced by default before active scans.
REQUIRE_DOMAIN_VERIFICATION=true
# Optional local academic lab allowlist (effective ONLY when APP_ENV=development)
ALLOW_LAB_LOCAL_TARGETS=false
LAB_TARGET_ALLOWLIST=[]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
MAX_SCAN_TIMEOUT_SECONDS=180
HTTP_REQUEST_TIMEOUT_SECONDS=15
REPORTS_DIR=/app/data/reports

# --- External Public Intelligence APIs (Passive Lookups) ---
CRT_SH_BASE_URL=https://crt.sh
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
